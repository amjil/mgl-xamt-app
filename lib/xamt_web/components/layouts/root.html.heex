<!DOCTYPE html>
<html lang="mn-Mong" data-theme="steppe-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#f7f4eb" />
    <meta name="ime-base-url" content={ime_base_url()} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Xamt" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href={~p"/pwa/manifest.json"} />
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32.png"} />
    <link rel="icon" type="image/png" sizes="16x16" href={~p"/images/favicon-16.png"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <%!-- iOS PWA splash --%>
    <link
      rel="apple-touch-startup-image"
      href={~p"/images/splash-1290x2796.png"}
      media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3)"
    />
    <link
      rel="apple-touch-startup-image"
      href={~p"/images/splash-1170x2532.png"}
      media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3)"
    />
    <link
      rel="apple-touch-startup-image"
      href={~p"/images/splash-1125x2436.png"}
      media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3)"
    />
    <link
      rel="apple-touch-startup-image"
      href={~p"/images/splash-2048x2732.png"}
      media="(device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2)"
    />

    <link
      rel="preload"
      href={~p"/fonts/OyunQaganTig.ttf"}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <%!-- Zero-delay theme: apply before CSS paint to avoid flash --%>
    <script>
      (function () {
        var valid = ["steppe-light", "night-sky", "crimson-felt", "jade-meadow"];
        var darkThemes = { "night-sky": true, "crimson-felt": true };
        var theme = localStorage.getItem("xamt_theme");
        if (valid.indexOf(theme) === -1) {
          var legacy = localStorage.getItem("phx:theme");
          if (legacy === "light") theme = "steppe-light";
          else if (legacy === "dark") theme = "night-sky";
          else if (legacy === "system") {
            theme = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "night-sky"
              : "steppe-light";
          } else {
            theme = "steppe-light";
          }
        }
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.classList.toggle("dark", !!darkThemes[theme]);
        window.addEventListener("xamt:set_theme", function (e) {
          var next = e.detail && e.detail.theme;
          if (valid.indexOf(next) === -1) return;
          document.documentElement.setAttribute("data-theme", next);
          document.documentElement.classList.toggle("dark", !!darkThemes[next]);
          localStorage.setItem("xamt_theme", next);
        });
      })();
    </script>
    <.live_title default="Xamt" suffix=" · Xamt">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="xamt-body">
    <div
      id="xamt-offline-banner"
      class="xamt-offline-banner"
      role="status"
      aria-live="polite"
      aria-hidden="true"
    >
      <.icon name="hero-wifi" class="w-4 h-4" />
      <span class="mongol-text">{gettext("Network disconnected, reconnecting…")}</span>
    </div>

    <div class="xamt-shell mn-shell">
      <%!-- Left rail: always on the left so labels read top→bottom --%>
      <aside id="leftnav" class="xamt-leftnav mn-rail">
        <nav class="xamt-leftnav__inner">
          <.link navigate={~p"/"} class="xamt-brand-mark" title="Xamt" aria-label="Xamt">
            <img
              src={~p"/images/pwa-icon-192.png"}
              alt=""
              width="42"
              height="42"
              decoding="async"
            />
          </.link>
          <span class="xamt-leftnav__rule" aria-hidden="true"></span>

          <ul class="xamt-leftnav__links">
            <%= if @current_scope && @current_scope.user do %>
              <li>
                <.link navigate={~p"/"} class="mongol-text">{gettext("Home")}</.link>
              </li>
              <li>
                <.link navigate={~p"/saved"} class="mongol-text">{gettext("Saved")}</.link>
              </li>
              <li>
                <.link navigate={~p"/settings"} class="mongol-text">{gettext("Settings")}</.link>
              </li>
              <li :if={site_admin?(@current_scope)}>
                <.link navigate={~p"/admin/users"} class="mongol-text">
                  {gettext("Users")}
                </.link>
              </li>
              <li>
                <.link href={~p"/users/log-out"} method="delete" class="mongol-text">
                  {gettext("Log out")}
                </.link>
              </li>
            <% else %>
              <li>
                <.link navigate={~p"/login"} class="mongol-text">{gettext("Log in")}</.link>
              </li>
              <li :if={@registration_enabled?}>
                <.link navigate={~p"/register"} class="mongol-text">{gettext("Register")}</.link>
              </li>
            <% end %>
          </ul>

          <div class="xamt-leftnav__foot">
            <.theme_palette id="xamt-theme-palette-nav" />
          </div>
        </nav>
      </aside>

      <%!-- Reading surface (vertical-lr for non-chat pages) --%>
      <div class="xamt-main-content mn-surface" id="page-scroll">
        {@inner_content}
      </div>
    </div>
  </body>
</html>

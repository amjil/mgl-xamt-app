<!DOCTYPE html>
<html lang="mn" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#1a1f24" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Xamt" />
    <link rel="manifest" href={~p"/pwa/manifest.json"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <.live_title default="Xamt" suffix=" · Xamt">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="xamt-body">
    <%!-- Mobile top bar (small screens only) --%>
    <div class="xamt-mobile-header">
      <.link navigate={~p"/"} class="xamt-brand" style="font-size: 1.5rem; margin: 0;">
        Xamt
      </.link>
      <button
        type="button"
        onclick="document.getElementById('leftnav').classList.toggle('is-open')"
        class="xamt-mobile-toggle"
        aria-label={gettext("Open menu")}
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          >
          </path>
        </svg>
      </button>
    </div>

    <%!-- Fixed left sidebar nav --%>
    <aside id="leftnav" class="xamt-leftnav">
      <nav class="xamt-leftnav__inner">
        <.link navigate={~p"/"} class="xamt-brand-mark mb-8">X</.link>

        <ul class="xamt-leftnav__links">
          <%= if @current_scope && @current_scope.user do %>
            <li>
              <.link navigate={~p"/settings"} class="mongol-text">{gettext("Settings")}</.link>
            </li>
            <li>
              <.link href={~p"/users/log-out"} method="delete" class="mongol-text">
                {gettext("Log out")}
              </.link>
            </li>
          <% else %>
            <li>
              <.link navigate={~p"/register"} class="mongol-text">{gettext("Register")}</.link>
            </li>
            <li>
              <.link navigate={~p"/login"} class="mongol-text">{gettext("Log in")}</.link>
            </li>
          <% end %>
        </ul>

        <%!-- Mobile close button --%>
        <button
          type="button"
          onclick="document.getElementById('leftnav').classList.remove('is-open')"
          class="xamt-leftnav__close xamt-btn xamt-btn--soft mongol-text"
        >
          {gettext("Close")}
        </button>
      </nav>
    </aside>

    <%!-- Main content --%>
    <div class="xamt-main-content">
      {@inner_content}
    </div>
  </body>
</html>

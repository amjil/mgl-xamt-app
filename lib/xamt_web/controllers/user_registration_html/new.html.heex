<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="xamt-stack" id="register-panel">
    <.header>
      {gettext("Register")}
      <:subtitle>
        {gettext("Already registered?")}
        <.link href={~p"/login"} class="xamt-link">
          {gettext("Log in")}
        </.link>
      </:subtitle>
    </.header>

    <.form
      :let={f}
      for={@changeset}
      action={~p"/register"}
      id="user-registration-form"
      class="xamt-form"
    >
      <.input
        field={f[:email]}
        type="email"
        label={gettext("Email")}
        autocomplete="email"
        spellcheck="false"
        required
      />
      <.input
        field={f[:username]}
        type="text"
        label={gettext("Username")}
        autocomplete="username"
        spellcheck="false"
        required
      />
      <label class="xamt-label">
        <span class="xamt-field__label">{gettext("Display name")}</span>
        <input
          type="text"
          name="user[display_name]"
          id="user_display_name"
          value={f[:display_name].value}
          class="xamt-input mongol-input"
          autocomplete="nickname"
        />
        <mgl-ime target="#user_display_name" profile="auto" keyboard="auto"></mgl-ime>
      </label>
      <.input
        field={f[:password]}
        type="password"
        label={gettext("Password")}
        autocomplete="new-password"
        required
      />
      <.input
        field={f[:password_confirmation]}
        type="password"
        label={gettext("Confirm password")}
        autocomplete="new-password"
        required
      />

      <.button variant="primary" class="xamt-btn xamt-btn--primary">
        {gettext("Create an account")}
      </.button>
    </.form>
  </section>
</Layouts.app>

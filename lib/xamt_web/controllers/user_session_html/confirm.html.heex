<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="xamt-stack" id="confirm-panel">
    <div class="xamt-auth-intro">
      <span class="xamt-ornament" aria-hidden="true"></span>
      <p class="xamt-kicker mongol-text">{gettext("Welcome")}</p>
    </div>
    <.header>
      {gettext("Welcome")}
      <:subtitle>
        <span class="xamt-profile__username">{@user.email}</span>
      </:subtitle>
    </.header>

    <.form
      :if={!@user.confirmed_at}
      for={@form}
      id="confirmation_form"
      action={~p"/users/log-in?_action=confirmed"}
      class="xamt-form xamt-form--vertical"
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
      <.button
        name={@form[:remember_me].name}
        value="true"
        phx-disable-with={gettext("Confirming...")}
        variant="primary"
        class="xamt-btn xamt-btn--primary mongol-text"
      >
        {gettext("Confirm and stay logged in")}
      </.button>
      <.button phx-disable-with={gettext("Confirming...")} class="xamt-btn xamt-btn--soft mongol-text">
        {gettext("Confirm and log in only this time")}
      </.button>
    </.form>

    <.form
      :if={@user.confirmed_at}
      for={@form}
      id="login_form"
      action={~p"/users/log-in"}
      class="xamt-form xamt-form--vertical"
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
      <%= if @current_scope do %>
        <.button
          variant="primary"
          phx-disable-with={gettext("Logging in...")}
          class="xamt-btn xamt-btn--primary mongol-text"
        >
          {gettext("Log in")}
        </.button>
      <% else %>
        <.button
          name={@form[:remember_me].name}
          value="true"
          phx-disable-with={gettext("Logging in...")}
          variant="primary"
          class="xamt-btn xamt-btn--primary mongol-text"
        >
          {gettext("Keep me logged in on this device")}
        </.button>
        <.button
          phx-disable-with={gettext("Logging in...")}
          class="xamt-btn xamt-btn--soft mongol-text"
        >
          {gettext("Log me in only this time")}
        </.button>
      <% end %>
    </.form>
  </section>
</Layouts.app>

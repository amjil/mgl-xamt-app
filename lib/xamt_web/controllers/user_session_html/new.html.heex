<Layouts.home flash={@flash} current_scope={@current_scope}>
  <main id="login-panel" class="xamt-home-canvas" phx-hook="MongolianScroll">
    <%!-- Section 1: Welcome banner --%>
    <aside class="xamt-home-section">
      <header class="xamt-home-section__header">
        <div class="flex flex-row items-center gap-2">
          <.icon
            name="hero-arrow-right-end-on-rectangle"
            class="w-5 h-5 text-[var(--xamt-accent)] shrink-0"
          />
          <h1 class="font-bold text-base tracking-widest mongol-text">
            {gettext("Log in")}
          </h1>
        </div>
      </header>

      <div class="xamt-home-card justify-between">
        <div class="flex flex-row items-center gap-3 h-full">
          <span class="xamt-ornament !h-12" aria-hidden="true"></span>
          <p class="xamt-kicker mongol-text">{gettext("Welcome back")}</p>
          <p class="text-sm text-[var(--xamt-muted)] mongol-text leading-relaxed">
            <%= if @current_scope do %>
              {gettext("You need to reauthenticate to perform sensitive actions on your account.")}
            <% else %>
              {gettext("Sign in with your Mgl ID account.")}
            <% end %>
          </p>
        </div>
      </div>
    </aside>

    <%!-- Mgl ID OIDC (the only sign-in method) --%>
    <section class="xamt-home-section">
      <header class="xamt-home-section__header">
        <div class="flex flex-row items-center gap-2">
          <.icon name="hero-identification" class="w-5 h-5 text-[var(--xamt-accent)] shrink-0" />
          <h2 class="font-bold text-sm mongol-text">{gettext("Mgl ID")}</h2>
        </div>
      </header>

      <div class="xamt-home-card">
        <%= if @mgl_id_enabled? do %>
          <p class="text-sm text-[var(--xamt-muted)] mongol-text leading-relaxed">
            {gettext("Sign in with your Mgl ID account.")}
          </p>
          <.link
            href={~p"/auth/mgl"}
            id="mgl-id-login"
            class="xamt-btn xamt-btn--primary h-full px-3.5 font-bold text-xs mongol-text"
          >
            <.icon name="hero-arrow-right-end-on-rectangle" class="w-4 h-4 mb-1.5" />
            <span>{gettext("Continue with Mgl ID")}</span>
          </.link>
        <% else %>
          <p
            id="mgl-id-disabled"
            class="text-sm text-[var(--xamt-muted)] mongol-text leading-relaxed"
          >
            {gettext(
              "Mgl ID login is disabled. Start the app with start.sh (or set MGL_ID_ENABLED=true)."
            )}
          </p>
        <% end %>
      </div>
    </section>
  </main>
</Layouts.home>
